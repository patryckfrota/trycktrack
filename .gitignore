.DS_Store
.auto-push.log
.auto-push-stdout.log
.auto-push-stderr.log
.env
.env.*
!.env.example

# Scaffold gerado pelo Firebase CLI (Hosting) — não usamos, o app
# continua publicado via GitHub Pages.
.firebase/
.firebaserc
firebase.json
public/

# Backend (Node/Prisma) — dependências e artefatos gerados, nunca
# versionados. node_modules por si só já passava de 270MB.
node_modules/
backend/tmp/

# Cloud Functions (geração de estações OSCE via Gemini). A chave da IA
# nunca é um arquivo local — fica só no Secret Manager do Firebase.
functions/node_modules/
functions/.env*
firebase-debug.log
firebase-debug.*.log

# Artefatos de build/captura de PDF (gerados a cada execução local).
tmp/
output/
