generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamTrack {
  ENAMED
  UEPA
}

enum AttemptKind {
  DIAGNOSTIC
  RECALIBRATION
  FIXATION
}

enum PhaseStatus {
  LOCKED
  AVAILABLE
  THEORY
  QUESTIONS
  COMPLETE
}

model User {
  id            String              @id @default(cuid())
  firebaseUid   String              @unique
  email         String              @unique
  displayName   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  trails        StudyTrail[]
  attempts      AssessmentAttempt[]
  performance   PerformanceRecord[]
  osceSessions  OsceSession[]
  questionAnswers QuestionResponse[]
  questionReviews UserQuestionReview[]
}

// ---------- QuestHub (banco de questões) ----------
// Fonte de verdade nova para o acervo do QuestHub — até aqui, as
// questões só existiam como arrays literais nos arquivos estáticos
// questions-*.js (achado C-3 da auditoria). Esses arquivos continuam
// sendo o que o PWA carrega hoje (mudar isso é uma revisão de
// arquitetura maior, com implicação em cache offline via Service
// Worker — não é este commit); scripts/import-questions.js popula
// estas tabelas A PARTIR desses arquivos, então por enquanto os
// arquivos são a fonte e o banco é uma cópia consultável. O objetivo
// deste passo é só destravar o que a ausência de modelagem impedia:
// histórico por questão (QuestionResponse) e uma fonte que sobrevive
// a limpar o localStorage — sem isso, nada mais do achado C-3
// (sincronização entre aparelhos, análise por item) tem onde morar.
enum QuestionBank {
  PRINCIPAL
  INTERNATO
}

model Question {
  id                String               @id
  bank              QuestionBank
  area              String
  subarea           String?
  stem              String
  answer            String?
  annulled          Boolean              @default(false)
  needsVisualReview Boolean              @default(false)
  questionType      String               @default("multiple_choice")
  examId            String?
  examName          String?
  source            String?
  sourceCode        String?
  number            Int?
  images            String[]             @default([])
  // Só preenchidos no banco INTERNATO (rodizio/tópico/tema/semestre
  // substituem area/subarea como esquema de filtro — ver
  // questions-internato.js).
  rodizio           String?
  topico            String?
  tema              String?
  semestre          String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  options           QuestionOption[]
  explanation       QuestionExplanation?
  responses         QuestionResponse[]
  reviews           UserQuestionReview[]

  @@index([bank, area, subarea])
  @@index([bank, examId])
  @@index([rodizio, topico, tema, semestre])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  letter     String
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, letter])
}

// Separado de Question de propósito: é o campo mais pesado do acervo
// (question-explanations.js/question-explanations-internato.js somam
// quase 4MB, extraídos do boot do PWA por lazy-load — ver M-1) e só é
// lido depois que alguém responde.
model QuestionExplanation {
  questionId String   @id
  body       String
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// O que hoje só existe em trycktrack-review-queue-v1/trycktrack-
// question-stats no localStorage do dispositivo — some ao trocar de
// aparelho ou limpar dados do site, e nunca guarda QUAL questão foi
// respondida (só contadores agregados). Ainda não é escrito por
// nenhuma rota (isso é a funcionalidade de sync, fora do escopo
// deste passo — ver roadmap R-5); a tabela existe pra ter onde
// esse histórico morar quando essa funcionalidade for construída.
model QuestionResponse {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  chosen     String?
  correct    Boolean?
  elapsedMs  Int?
  answeredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([questionId, correct])
  @@index([userId, questionId])
}

// Estado de revisão espaçada por usuário×questão (R-1 + R-5) — espelha
// o que hoje só existe em trycktrack-review-queue-v1 no localStorage de
// CADA dispositivo, sem nada em comum entre eles. Chave composta
// (userId, questionId) em vez de um blob JSON por usuário de propósito:
// dá pra fazer merge "mantém o mais recente" POR QUESTÃO (ver
// shared/sync-merge.js/mergeReviewEntry, usada nos dois lados — cliente
// e backend/src/syncRepository.js) sem o risco de um dispositivo com
// menos progresso sobrescrever o de outro só porque sincronizou por
// último. Nunca guarda agregados (respondidas/acertos) — esses vêm de
// COUNT/GROUP BY em QuestionResponse quando forem exibidos, pra não ter
// um contador que possa divergir do log de respostas que já existe.
model UserQuestionReview {
  userId         String
  questionId     String
  stability      Float
  difficulty     Float
  dueDate        DateTime
  lastReviewedAt DateTime
  lastRating     Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, dueDate])
}

model Theme {
  id               String              @id @default(cuid())
  area             String
  name             String
  incidenceEnamed  Float
  incidenceUepa    Float
  metadata         Json?
  createdAt        DateTime            @default(now())
  phases           TrailPhase[]
  performance      PerformanceRecord[]

  @@unique([area, name])
}

model StudyTrail {
  id                 String              @id @default(cuid())
  userId             String
  track              ExamTrack
  diagnosticDoneAt   DateTime?
  lastRecalibratedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases             TrailPhase[]
  attempts           AssessmentAttempt[]

  @@unique([userId, track])
}

model TrailPhase {
  id            String       @id @default(cuid())
  trailId       String
  themeId       String
  position      Int
  priorityScore Float
  progress      Int          @default(0)
  status        PhaseStatus  @default(LOCKED)
  unlockedAt    DateTime?
  completedAt   DateTime?
  trail         StudyTrail   @relation(fields: [trailId], references: [id], onDelete: Cascade)
  theme         Theme        @relation(fields: [themeId], references: [id])

  @@unique([trailId, themeId])
  @@unique([trailId, position])
}

model AssessmentAttempt {
  id               String             @id @default(cuid())
  userId           String
  trailId          String?
  kind             AttemptKind
  totalQuestions   Int
  correctQuestions Int                @default(0)
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trail            StudyTrail?        @relation(fields: [trailId], references: [id], onDelete: SetNull)
  responses        AssessmentResponse[]
}

model AssessmentResponse {
  id          String            @id @default(cuid())
  attemptId   String
  themeId     String?
  area        String
  correct     Boolean
  createdAt   DateTime          @default(now())
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model PerformanceRecord {
  id         String      @id @default(cuid())
  userId     String
  themeId    String
  source     AttemptKind
  accuracy   Float
  sampleSize Int
  measuredAt DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme      Theme       @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([userId, themeId, measuredAt])
}

enum OsceMode {
  EVALUATOR
  CANDIDATE
}

enum OsceStationFormat {
  ANAMNESE_FOCADA
  EXAME_FISICO
  RACIOCINIO_DIAGNOSTICO
  CONDUTA
  PROCEDIMENTO
  COMUNICACAO
  URGENCIA_EMERGENCIA
  ESTACAO_COMPLETA
}

enum OsceStationStatus {
  DRAFT
  GENERATED
  REVIEWED
  APPROVED
  ARCHIVED
}

enum OsceEventType {
  STATION_STARTED
  CANDIDATE_MESSAGE
  PATIENT_RESPONSE
  PHYSICAL_EXAM_REQUESTED
  PHYSICAL_EXAM_RESULT
  TEST_REQUESTED
  TEST_RESULT_RELEASED
  MEDICATION_ORDERED
  PROCEDURE_PERFORMED
  CLINICAL_DECISION
  STATION_FINISHED
  STATION_TIMEOUT
}

model OsceStation {
  id                    String            @id @default(cuid())
  subthemeId            String
  format                OsceStationFormat
  title                 String
  status                OsceStationStatus @default(DRAFT)
  version               Int               @default(1)
  generationSource      String            @default("MANUAL")
  schemaVersion         String            @default("1.0.0")
  externalId            String?
  fingerprint           String            @unique
  importBatchId         String?
  clinicalContentJson   Json?
  evaluatorContentJson  Json?
  modelName             String?
  promptVersion         String?
  guidelineVersion      String?
  clinicalReviewDate    DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  subtheme              OsceSubtheme      @relation(fields: [subthemeId], references: [id])
  importBatch           OsceImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sessions              OsceSession[]
  @@index([subthemeId, format, status])
  @@index([externalId, version])
}

model OsceImportBatch {
  id             String        @id @default(cuid())
  sourceName     String?
  totalItems     Int
  importedItems  Int
  duplicateItems Int
  createdAt      DateTime      @default(now())
  stations       OsceStation[]
}

model OsceArea {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  order    Int
  active   Boolean      @default(true)
  themes   OsceTheme[]
}

model OsceTheme {
  id        String         @id @default(cuid())
  areaId    String
  code      String
  name      String
  order     Int
  active    Boolean        @default(true)
  area      OsceArea       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  subthemes OsceSubtheme[]
  @@unique([areaId, code])
  @@index([areaId, order])
}

model OsceSubtheme {
  id          String        @id @default(cuid())
  themeId     String
  name        String
  slug        String
  description String?
  order       Int
  active      Boolean       @default(true)
  theme       OsceTheme     @relation(fields: [themeId], references: [id], onDelete: Cascade)
  stations    OsceStation[]
  @@unique([themeId, slug])
  @@index([themeId, order])
}

model OsceSession {
  id          String          @id @default(cuid())
  userId      String?
  clientUserKey String
  stationId   String
  mode        OsceMode
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  debriefing  String?
  summary     Json?
  currentTaskIndex Int       @default(0)
  taskAssessments Json?
  finalRevealed   Boolean    @default(false)
  resultDeliveredAt DateTime?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  station     OsceStation     @relation(fields: [stationId], references: [id])
  events      OsceEvent[]
  checklist   OsceChecklistScore[]
  @@index([clientUserKey, startedAt])
}

model OsceEvent {
  id          String        @id @default(cuid())
  sessionId   String
  type        OsceEventType
  payload     Json
  createdAt   DateTime      @default(now())
  session     OsceSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model OsceChecklistScore {
  id             String      @id @default(cuid())
  sessionId      String
  category       String
  item           String
  points         Float
  awardedPoints  Float
  session        OsceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, category])
}

// Erros de JS não tratados capturados no app do aluno (window.onerror +
// unhandledrejection, ver app-app.js) — hoje não existe NENHUMA
// visibilidade de produção, um erro na tela do aluno simplesmente some.
// Sem FK pra User de propósito: muitos erros acontecem antes do login
// (splash, onboarding), e não pode se perder um erro só porque não
// tinha sessão — userId aqui é só um id de referência solto, nunca
// resolvido/validado contra a tabela User.
model ClientError {
  id         String   @id @default(cuid())
  message    String
  stack      String?
  url        String?
  userAgent  String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
